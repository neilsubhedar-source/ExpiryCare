# ============================================================
# ExpiryCare Backend — Environment Configuration Template
# DO NOT commit actual secrets or credentials to version control.
# Copy this file to .env and supply your local or production values.
# ============================================================

# Flask server configuration
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5000
HOST=0.0.0.0
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# CORS origins (comma-separated list of allowed frontend URLs)
# Example for local development:
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
# Example for production:
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# Firebase Cloud Firestore configuration
# Set FIRESTORE_ENABLED=true once Firebase service account credentials are in place
FIRESTORE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Alternative for Render: paste the complete service-account JSON as one secret value.
# Prefer Render secret files when available; never commit credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=

# External AI & OCR Providers (Optional)
# Leave blank for standard offline fallback responses
OPENAI_API_KEY=
# Optional Google Gemini API key (AI Studio free tier may be available; quotas and eligibility vary).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# Expiry Logic Configuration
SOON_LIMIT_DAYS=30

# Email reminders (Gmail requires an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS reminders (Twilio account and sender required)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPIRY_REMINDER_DAYS=7
TESSERACT_CMD=
